# Models
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
LLM_MODEL=Qwen/Qwen2-1.5B-Instruct

# Router
ROUTER_PROVIDER=local
ROUTER_MODEL=gemini-2.5-flash-lite
GOOGLE_API_KEY=
WEB_SEARCH_MAX_RESULTS=3
AGENT_MODE=deep
DEEP_AGENT_MODEL=gemini-2.5-flash
DEEP_AGENT_RECURSION_LIMIT=40

# Retrieval
VECTOR_WEIGHT=0.7
BM25_WEIGHT=0.3
TOP_K=4
RETRIEVAL_K=20
ENABLE_RERANK=true
ENABLE_HYBRID=true
HYBRID_K=10
RERANK_K=5
MIN_HYBRID_SCORE=0.15
MIN_RERANK_SCORE=0.10

# Chunking
CHUNK_SIZE=400
CHUNK_OVERLAP=80

# API
API_PORT=7860
STREAM_DELAY=0.02
MAX_UPLOAD_MB=15

# Storage
DATA_DIR=/data/data
STORAGE_DIR=/data/storage
JOURNAL_BACKEND=sqlite
JOURNAL_SQLITE_PATH=/data/db/journal_demo.db
JOURNAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/journal_db

# Debug
DEBUG=false
SHOW_RETRIEVED=false
SHOW_RERANKED=false
